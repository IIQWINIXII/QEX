@* Components/ColorPanel.razor *@

<div class="color-panel">
    @foreach (var c in Palette)
    {
        <button @onclick="@(() => SelectColor(c))"
                class="color-btn @(c == Selected ? "active" : "")"
                style="background:@c;"
                title="@c"></button>
    }

    <div class="divider"></div>

    <input type="color"
           value="@Selected"
           @onchange="OnCustomColorChanged"
           class="color-picker"
           title="Свой цвет">

    <div class="divider"></div>

    <label class="size-label">@Size</label>
    <input type="range" min="1" max="20" value="@Size"
           @oninput="OnSizeInput"
           class="size-slider" />
</div>

<style>
    .color-panel {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 10px 6px;
        background: #f5f5f5;
        border-left: 1px solid #ddd;
        height: 100%;
        box-sizing: border-box;
    }

    .color-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        padding: 0;
        cursor: pointer;
        border: 2px solid #ccc;
        transition: transform .1s, box-shadow .15s;
    }

        .color-btn:hover {
            transform: scale(1.08);
        }

        .color-btn.active {
            border-color: #0078d7;
            box-shadow: 0 0 0 2px rgba(0,120,215,.35);
        }

    .divider {
        width: 28px;
        height: 1px;
        background: #ccc;
        margin: 2px 0;
    }

    .color-picker {
        width: 36px;
        height: 32px;
        padding: 0;
        border: 1px solid #ccc;
        border-radius: 6px;
        cursor: pointer;
        background: #fff;
    }

    .size-label {
        font-size: 12px;
        color: #333;
        font-weight: 600;
    }

    .size-slider {
        writing-mode: vertical-lr;
        direction: rtl;
        width: 6px;
        height: 100px;
        cursor: pointer;
    }
</style>

@code {
    /// <summary>Текущий выбранный цвет.</summary>
    [Parameter] public string Selected { get; set; } = "#000000";

    /// <summary>Текущий размер кисти.</summary>
    [Parameter] public int Size { get; set; } = 3;

    /// <summary>Уведомление родителя о смене цвета.</summary>
    [Parameter] public EventCallback<string> SelectedChanged { get; set; }

    /// <summary>Уведомление родителя о смене размера.</summary>
    [Parameter] public EventCallback<int> SizeChanged { get; set; }

    private static readonly string[] Palette =
    {
        "#000000", "#FFFFFF", "#FF0000", "#00AA00", "#0000FF",
        "#FFD700", "#FF00FF", "#00CED1", "#FF8C00", "#800080"
    };

    private async Task SelectColor(string color)
    {
        if (color == Selected) return;
        await SelectedChanged.InvokeAsync(color);
    }

    private async Task OnCustomColorChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value)) return;
        await SelectedChanged.InvokeAsync(value);
    }

    private async Task OnSizeInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            await SizeChanged.InvokeAsync(newSize);
        }
    }
}