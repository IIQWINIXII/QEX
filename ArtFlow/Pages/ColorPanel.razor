@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="color-panel">
    <div class="wheel-container">
        <canvas @ref="_canvas" class="color-wheel" width="220" height="220"></canvas>
    </div>

    <div class="preview-row">
        <div class="preview-swatch" style="background: @CurrentHex"></div>
        <div class="hex-box">
            <input type="text" class="hex-input" value="@CurrentHex" @onchange="OnHexInput" />
        </div>
    </div>

    <div class="fields">
        <label>
            <span>H</span>
            <input type="range" min="0" max="360" step="1" value="@H" @oninput="OnHInput" />
        </label>
        <label>
            <span>S</span>
            <input type="range" min="0" max="100" step="1" value="@S" @oninput="OnSInput" />
        </label>
        <label>
            <span>V</span>
            <input type="range" min="0" max="100" step="1" value="@V" @oninput="OnVInput" />
        </label>
    </div>

    <div class="size-block">
        <div class="size-label">
            <span>Размер кисти</span>
            <span class="size-value">@Size px</span>
        </div>
        <input type="range" min="1" max="100" value="@Size" @oninput="OnSizeInput" />
    </div>
</div>

<style>
    .color-panel {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 12px;
        user-select: none;
        box-sizing: border-box;
        width: 100%;
        max-width: 280px;
    }

    .wheel-container {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        position: relative;
        margin: 0 auto;
    }

    .color-wheel {
        display: block;
        cursor: crosshair;
        border-radius: 50%;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        touch-action: none;
        width: 220px !important;
        height: 220px !important;
        max-width: 100%;
    }

    .preview-row {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .preview-swatch {
        width: 40px;
        height: 40px;
        border-radius: 6px;
        border: 1px solid #ccc;
        flex: 0 0 auto;
    }

    .hex-box {
        flex: 1 1 auto;
        min-width: 0;
    }

    .hex-input {
        width: 100%;
        box-sizing: border-box;
        font-family: monospace;
        font-size: 13px;
        text-align: center;
        padding: 8px 4px;
        border: 1px solid #ccc;
        border-radius: 4px;
        background: #fff;
    }

    .fields {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 12px;
        color: #444;
    }

        .fields label {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .fields label span:first-child {
                width: 16px;
                font-weight: 600;
            }

        .fields input[type=range] {
            flex: 1 1 auto;
            min-width: 0;
        }

    .size-block {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding-top: 8px;
        border-top: 1px solid #e0e0e0;
    }

    .size-label {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        color: #444;
    }

        .size-label .size-value {
            font-family: monospace;
            font-weight: 600;
        }

    .size-block input[type=range] {
        width: 100%;
    }
</style>

@code {
    [Parameter] public string Selected { get; set; } = "#000000";
    [Parameter] public EventCallback<string> SelectedChanged { get; set; }

    [Parameter] public int Size { get; set; } = 3;
    [Parameter] public EventCallback<int> SizeChanged { get; set; }

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ColorPanel>? _selfRef;
    private bool _initialized;

    private double _h = 0;
    private double _s = 100;
    private double _v = 100;

    private int H => (int)Math.Round(_h);
    private int S => (int)Math.Round(_s);
    private int V => (int)Math.Round(_v);

    private string CurrentHex => HsvToHex(_h, _s, _v);

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(Selected)) return;

        var normalized = NormalizeHex(Selected);
        if (!string.Equals(normalized, CurrentHex, StringComparison.OrdinalIgnoreCase))
        {
            var (h, s, v) = HexToHsv(normalized);
            _h = h;
            _s = s;
            _v = v;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_initialized && firstRender)
        {
            try
            {
                var asm = typeof(ArtFlow.Pages.Home).Assembly;
                _module = await JsModuleLoader.LoadAsync(JS, asm, "ColorPanel.razor.js");

                _selfRef = DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("init", _canvas, _selfRef);
                await _module.InvokeVoidAsync("redraw", _h, _s, _v);

                _initialized = true;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[ColorPanel] init failed: {ex}");
            }
            return;
        }

        if (_initialized && _module is not null)
        {
            await _module.InvokeVoidAsync("redraw", _h, _s, _v);
        }
    }

    [JSInvokable]
    public async Task OnJsPointer(double nx, double ny, bool isDown)
    {
        const double InnerR = 0.78;
        var dist = Math.Sqrt(nx * nx + ny * ny);

        if (dist > InnerR)
        {
            var angle = Math.Atan2(ny, nx) * 180.0 / Math.PI;
            _h = (angle + 360.0) % 360.0;
        }
        else
        {
            UpdateSvFromTriangle(nx, ny);
        }

        if (_module is not null)
            await _module.InvokeVoidAsync("redraw", _h, _s, _v);

        await EmitChanged();
    }

    private void UpdateSvFromTriangle(double nx, double ny)
    {
        const double InnerR = 0.78;
        double tr = InnerR * 0.98;
        double cos30 = Math.Cos(Math.PI / 6);
        double sin30 = 0.5;

        double ax = 0, ay = -tr;
        double bx = -tr * cos30, by = tr * sin30;
        double cx = tr * cos30, cy = tr * sin30;

        double d = (by - cy) * (ax - cx) + (cx - bx) * (ay - cy);
        if (Math.Abs(d) < 1e-9) return;

        double wa = ((by - cy) * (nx - cx) + (cx - bx) * (ny - cy)) / d;
        double wb = ((cy - ay) * (nx - cx) + (ax - cx) * (ny - cy)) / d;
        double wc = 1 - wa - wb;

        if (wa < 0 || wb < 0 || wc < 0)
        {
            wa = Math.Max(0, wa);
            wb = Math.Max(0, wb);
            wc = Math.Max(0, wc);
            var sum = wa + wb + wc;
            if (sum <= 0) return;
            wa /= sum; wb /= sum; wc /= sum;
        }

        _s = Math.Clamp(wa * 100.0, 0, 100);
        _v = Math.Clamp((wa + wb) * 100.0, 0, 100);
    }

    private async Task OnHInput(ChangeEventArgs e)
    {
        if (TryParseDouble(e, out var val))
        {
            _h = val;
            if (_module is not null) await _module.InvokeVoidAsync("redraw", _h, _s, _v);
            await EmitChanged();
        }
    }

    private async Task OnSInput(ChangeEventArgs e)
    {
        if (TryParseDouble(e, out var val))
        {
            _s = val;
            if (_module is not null) await _module.InvokeVoidAsync("redraw", _h, _s, _v);
            await EmitChanged();
        }
    }

    private async Task OnVInput(ChangeEventArgs e)
    {
        if (TryParseDouble(e, out var val))
        {
            _v = val;
            if (_module is not null) await _module.InvokeVoidAsync("redraw", _h, _s, _v);
            await EmitChanged();
        }
    }

    private async Task OnHexInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        var normalized = NormalizeHex(raw);
        if (normalized.Length != 7) return;

        var (h, s, v) = HexToHsv(normalized);
        _h = h; _s = s; _v = v;

        if (_module is not null) await _module.InvokeVoidAsync("redraw", _h, _s, _v);
        await EmitChanged();
    }

    private async Task OnSizeInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            Size = val;
            await SizeChanged.InvokeAsync(val);
        }
    }

    private async Task EmitChanged()
    {
        var hex = CurrentHex;
        if (!string.Equals(hex, Selected, StringComparison.OrdinalIgnoreCase))
        {
            Selected = hex;
            await SelectedChanged.InvokeAsync(hex);
        }
    }

    private static bool TryParseDouble(ChangeEventArgs e, out double value)
    {
        value = 0;
        var s = e.Value?.ToString();
        if (string.IsNullOrEmpty(s)) return false;
        return double.TryParse(s, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out value);
    }

    private static string NormalizeHex(string hex)
    {
        if (string.IsNullOrWhiteSpace(hex)) return "#000000";
        hex = hex.Trim().TrimStart('#');
        if (hex.Length == 3)
            hex = $"{hex[0]}{hex[0]}{hex[1]}{hex[1]}{hex[2]}{hex[2]}";
        if (hex.Length != 6) return "#000000";
        foreach (var ch in hex)
            if (!Uri.IsHexDigit(ch)) return "#000000";
        return "#" + hex.ToUpperInvariant();
    }

    public static string HsvToHex(double h, double s, double v)
    {
        double c = v / 100.0 * s / 100.0;
        double hh = ((h % 360.0) + 360.0) % 360.0 / 60.0;
        double x = c * (1 - Math.Abs(hh % 2 - 1));
        double m = v / 100.0 - c;

        double r1 = 0, g1 = 0, b1 = 0;
        if (hh < 1) { r1 = c; g1 = x; b1 = 0; }
        else if (hh < 2) { r1 = x; g1 = c; b1 = 0; }
        else if (hh < 3) { r1 = 0; g1 = c; b1 = x; }
        else if (hh < 4) { r1 = 0; g1 = x; b1 = c; }
        else if (hh < 5) { r1 = x; g1 = 0; b1 = c; }
        else { r1 = c; g1 = 0; b1 = x; }

        int r = (int)Math.Round((r1 + m) * 255);
        int g = (int)Math.Round((g1 + m) * 255);
        int b = (int)Math.Round((b1 + m) * 255);

        return $"#{r:X2}{g:X2}{b:X2}";
    }

    public static (double H, double S, double V) HexToHsv(string hex)
    {
        hex = NormalizeHex(hex).TrimStart('#');
        int r = Convert.ToInt32(hex.Substring(0, 2), 16);
        int g = Convert.ToInt32(hex.Substring(2, 2), 16);
        int b = Convert.ToInt32(hex.Substring(4, 2), 16);

        double rf = r / 255.0, gf = g / 255.0, bf = b / 255.0;
        double max = Math.Max(rf, Math.Max(gf, bf));
        double min = Math.Min(rf, Math.Min(gf, bf));
        double d = max - min;

        double h = 0;
        if (d > 0)
        {
            if (max == rf) h = 60 * (((gf - bf) / d) % 6);
            else if (max == gf) h = 60 * ((bf - rf) / d + 2);
            else h = 60 * ((rf - gf) / d + 4);
        }
        if (h < 0) h += 360;

        double s = max <= 0 ? 0 : d / max * 100.0;
        double v = max * 100.0;

        return (h, s, v);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
        _selfRef?.Dispose();
    }
}