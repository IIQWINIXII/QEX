@* Components/Draw.razor *@
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="draw-app">
    <div class="toolbar">
        <span class="title">✏️ Рисование</span>
        <div class="group" style="margin-left:auto;">
            <button @onclick="Clear">🗑 Очистить</button>
            <button @onclick="HandleClose" class="btn-close">✖ Закрыть</button>
        </div>
    </div>

    <div class="workspace">
        <ToolsPanel Selected="@_tool" SelectedChanged="OnToolChanged" />

        <div class="canvas-wrap">
            <canvas @ref="_canvas" id="drawCanvas" width="800" height="500"
                    @onmousedown="OnMouseDown" @onmousemove="OnMouseMove"
                    @onmouseup="OnMouseUp" @onmouseleave="OnMouseLeave">
            </canvas>
        </div>

        <ColorPanel Selected="@_color"
                    SelectedChanged="OnColorChanged"
                    Size="@_size"
                    SizeChanged="OnSizeChanged" />
    </div>
</div>

<style>
    .draw-app {
        max-width: 1000px;
        margin: 1rem auto;
        font-family: system-ui, sans-serif;
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
        background: #fafafa;
        display: flex;
        flex-direction: column;
    }

    .toolbar {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        background: #f5f5f5;
        border-bottom: 1px solid #ddd;
    }

        .toolbar .title {
            font-weight: 600;
            font-size: 14px;
            color: #333;
        }

        .toolbar button {
            padding: 6px 10px;
            cursor: pointer;
            border: 1px solid #ccc;
            background: #fff;
            border-radius: 4px;
            font-size: 13px;
            transition: all 0.2s;
        }

            .toolbar button:hover {
                background: #e9ecef;
            }

    .btn-close {
        background: #dc3545;
        color: white;
        border-color: #dc3545;
    }

        .btn-close:hover {
            background: #bb2d3b;
        }

    .workspace {
        display: grid;
        grid-template-columns: 56px 1fr 56px;
        align-items: stretch;
        background: #e9ecef;
    }

    .canvas-wrap {
        padding: 12px;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        background: #e9ecef;
    }

    canvas {
        border: 1px solid #444;
        background: #fff;
        cursor: crosshair;
        display: block;
        max-width: 100%;
        border-radius: 4px;
        box-shadow: 0 1px 4px rgba(0,0,0,.15);
    }
</style>

@code {
    [Parameter, EditorRequired] public EventCallback OnClose { get; set; }

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private string _tool = "pencil";
    private string _color = "#000000";
    private int _size = 3;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var asm = typeof(Home).Assembly;
            _module = await JsModuleLoader.LoadAsync(JS, asm, "Draw.js");

            await _module.InvokeVoidAsync("init", _canvas);
            await SyncSettings();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Draw] init failed: {ex}");
        }
    }

    private async Task SyncSettings()
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("sync", _tool, _color, _size);
    }

    // ---- Обработчики панелей ----

    private async Task OnToolChanged(string tool)
    {
        _tool = tool;
        StateHasChanged();
        await SyncSettings();
    }

    private async Task OnColorChanged(string color)
    {
        _color = color;
        StateHasChanged();
        await SyncSettings();
    }

    private async Task OnSizeChanged(int size)
    {
        _size = size;
        StateHasChanged();
        await SyncSettings();
    }

    // ---- Мышь ----

    private async Task OnMouseDown(MouseEventArgs e)
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("start", e.ClientX, e.ClientY);
    }

    private async Task OnMouseMove(MouseEventArgs e)
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("move", e.ClientX, e.ClientY);
    }

    private async Task OnMouseUp(MouseEventArgs e)
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("end");
    }

    private async Task OnMouseLeave()
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("end");
    }

    // ---- Действия ----

    private async Task Clear()
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("clear");
    }

    private async Task HandleClose() => await OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
    }
}