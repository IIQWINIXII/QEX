@* Components/Draw.razor *@
@using ArtFlow.Classes
@using ArtFlow.Pages
@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="draw-app">
    <div class="toolbar">
        <button @onclick="@(() => _showSettings = true)" title="Настройки холста">⚙️ Холст</button>
        <button @onclick="Save">💾 Сохранить PNG</button>
        <button @onclick="Clear">🗑 Очистить</button>

        <div class="group" style="margin-left:auto;">
            <span class="hint">@_settings.Width × @_settings.Height</span>
        </div>
    </div>

    <div class="workspace">
        <ToolsPanel Selected="@_tool" SelectedChanged="OnToolChanged" />

        <DrawCanvas @ref="_canvasRef"
                    Settings="_settings"
                    PointerDown="OnPointerDown"
                    PointerMove="OnPointerMove"
                    PointerUp="OnPointerUp"
                    SettingsChanged="SyncSettings" />

        <div class="right-dock">
            <!-- Цвет и размер теперь аккуратно сгруппированы внутри ColorPanel -->
            <ColorPanel Selected="@_color"
                        SelectedChanged="OnColorChanged"
                        Size="@_size"
                        SizeChanged="OnSizeChanged" />

            <div class="layers-wrap">
                <LayersPanel Layers="_layers"
                             ActiveId="@_activeLayerId"
                             ActionRequested="OnLayerAction" />
            </div>
        </div>
    </div>

    <CanvasOptionDialog @bind-Visible="_showSettings"
                        Settings="_settings"
                        Applied="OnSettingsApplied" />
</div>

<style>
    .draw-app {
        position: fixed;
        inset: 0;
        display: flex;
        flex-direction: column;
        font-family: system-ui, sans-serif;
        background: #fafafa;
        overflow: hidden;
    }

    .toolbar {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        background: #f5f5f5;
        border-bottom: 1px solid #ddd;
    }

        .toolbar .hint {
            font-size: 12px;
            color: #666;
            margin-right: 8px;
        }

        .toolbar button {
            padding: 6px 10px;
            cursor: pointer;
            border: 1px solid #ccc;
            background: #fff;
            border-radius: 4px;
            font-size: 13px;
            transition: background .15s;
        }

            .toolbar button:hover {
                background: #e9ecef;
            }

    .workspace {
        flex: 1 1 auto;
        min-height: 0;
        display: grid;
        grid-template-columns: 56px 1fr 280px;
        align-items: stretch;
        background: #e9ecef;
        overflow: hidden;
    }

    .right-dock {
        display: flex;
        flex-direction: column;
        background: #fff;
        border-left: 1px solid #ddd;
        min-height: 0;
        overflow: hidden;
    }

        .right-dock .layers-wrap {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
        }
</style>

@code {
    [Parameter, EditorRequired] public EventCallback OnClose { get; set; }

    private DrawCanvas? _canvasRef;
    private CanvasSettings _settings = new();
    private bool _showSettings = true;
    private string _tool = "pencil";
    private string _color = "#000000";
    private int _size = 3;

    private List<LayerInfo> _layers = new();
    private string? _activeLayerId;

    protected override void OnInitialized()
    {
        var first = new LayerInfo { Name = "Слой 1" };
        _layers.Add(first);
        _activeLayerId = first.Id;
    }

    private async Task OnSettingsApplied(CanvasSettings s)
    {
        _settings = s;
        StateHasChanged();

        if (_canvasRef?.Module is not null)
        {
            await _canvasRef.Module.InvokeVoidAsync("resize", s.Width, s.Height, s.Background);
            await SyncLayersAfterResize();
            await SyncSettings();
        }
    }

    private async Task SyncLayersAfterResize()
    {
        if (_canvasRef?.Module is null) return;
        var ids = _layers.Select(l => l.Id).ToArray();
        await _canvasRef.Module.InvokeVoidAsync("reinitLayers", ids, _activeLayerId);
        await SyncAllLayers();
    }

    private async Task SyncSettings()
    {
        if (_canvasRef?.Module is null) return;
        await _canvasRef.Module.InvokeVoidAsync("sync", _tool, _color, _size);
    }

    private async Task OnToolChanged(string tool)
    {
        _tool = tool;
        StateHasChanged();
        await SyncSettings();
    }

    private async Task OnColorChanged(string color)
    {
        _color = color;
        StateHasChanged();
        await SyncSettings();
    }

    private async Task OnSizeChanged(int size)
    {
        _size = size;
        StateHasChanged();
        await SyncSettings();
    }

    private async Task OnPointerDown((double X, double Y) p)
    {
        if (_canvasRef?.Module is null) return;
        await _canvasRef.Module.InvokeVoidAsync("start", p.X, p.Y);
    }

    private async Task OnPointerMove((double X, double Y) p)
    {
        if (_canvasRef?.Module is null) return;
        await _canvasRef.Module.InvokeVoidAsync("move", p.X, p.Y);
    }

    private async Task OnPointerUp()
    {
        if (_canvasRef?.Module is null) return;
        await _canvasRef.Module.InvokeVoidAsync("end");
    }

    private async Task Clear()
    {
        if (_canvasRef?.Module is null) return;
        await _canvasRef.Module.InvokeVoidAsync("clear");
    }

    private async Task Save()
    {
        if (_canvasRef?.Module is null) return;
        var dataUrl = await _canvasRef.Module.InvokeAsync<string>("toDataUrl");
        await JS.InvokeVoidAsync("eval",
            $"const a=document.createElement('a');" +
            $"a.href={System.Text.Json.JsonSerializer.Serialize(dataUrl)};" +
            $"a.download='art.png';a.click();");
    }

    private async Task HandleClose() => await OnClose.InvokeAsync();

    private int ActiveLayerIndex =>
        _activeLayerId is null ? -1 : _layers.FindIndex(l => l.Id == _activeLayerId);

    private async Task OnLayerAction(LayerAction a)
    {
        switch (a.Kind)
        {
            case LayerActionKind.Select:
                _activeLayerId = a.Id;
                if (_canvasRef?.Module is not null)
                    await _canvasRef.Module.InvokeVoidAsync("setActiveLayer", a.Id);
                await SyncActiveProps();
                break;

            case LayerActionKind.Add:
                {
                    var l = new LayerInfo { Name = $"Слой {_layers.Count + 1}" };
                    _layers.Add(l);
                    _activeLayerId = l.Id;
                    if (_canvasRef?.Module is not null)
                        await _canvasRef.Module.InvokeVoidAsync("addLayer", l.Id);
                    await SyncAllLayers();
                    break;
                }

            case LayerActionKind.Duplicate:
                {
                    var i = ActiveLayerIndex;
                    if (i < 0) break;
                    var srcId = _layers[i].Id;
                    var copy = _layers[i].Clone();
                    _layers.Insert(i + 1, copy);
                    _activeLayerId = copy.Id;
                    if (_canvasRef?.Module is not null)
                        await _canvasRef.Module.InvokeVoidAsync("duplicateLayer", srcId, copy.Id);
                    await SyncAllLayers();
                    break;
                }

            case LayerActionKind.Delete:
                {
                    if (_layers.Count <= 1) break;
                    var i = ActiveLayerIndex;
                    if (i < 0) break;
                    var id = _layers[i].Id;
                    _layers.RemoveAt(i);
                    _activeLayerId = _layers[Math.Max(0, i - 1)].Id;
                    if (_canvasRef?.Module is not null)
                        await _canvasRef.Module.InvokeVoidAsync("deleteLayer", id);
                    await SyncAllLayers();
                    break;
                }

            case LayerActionKind.MoveUp:
                {
                    var i = ActiveLayerIndex;
                    if (i < 0 || i >= _layers.Count - 1) break;
                    (_layers[i], _layers[i + 1]) = (_layers[i + 1], _layers[i]);
                    await SyncAllLayers();
                    break;
                }

            case LayerActionKind.MoveDown:
                {
                    var i = ActiveLayerIndex;
                    if (i <= 0) break;
                    (_layers[i], _layers[i - 1]) = (_layers[i - 1], _layers[i]);
                    await SyncAllLayers();
                    break;
                }

            case LayerActionKind.ToggleVisible:
                {
                    if (a.Index is int idx && idx >= 0 && idx < _layers.Count && a.Visible is bool v)
                    {
                        _layers[idx].Visible = v;
                        if (_canvasRef?.Module is not null)
                            await _canvasRef.Module.InvokeVoidAsync("setLayerVisible", _layers[idx].Id, v);
                    }
                    break;
                }

            case LayerActionKind.SetBlend:
                {
                    var i = ActiveLayerIndex;
                    if (i >= 0 && a.BlendMode is not null)
                    {
                        _layers[i].BlendMode = a.BlendMode;
                        await SyncActiveProps();
                    }
                    break;
                }

            case LayerActionKind.SetOpacity:
                {
                    var i = ActiveLayerIndex;
                    if (i >= 0 && a.Opacity is double op)
                    {
                        _layers[i].Opacity = op;
                        await SyncActiveProps();
                    }
                    break;
                }

            case LayerActionKind.Rename:
                {
                    var l = _layers.FirstOrDefault(x => x.Id == a.Id);
                    if (l is not null && !string.IsNullOrWhiteSpace(a.Name))
                        l.Name = a.Name!;
                    break;
                }
        }

        StateHasChanged();
    }

    private async Task SyncAllLayers()
    {
        if (_canvasRef?.Module is null) return;

        var ids = _layers.Select(l => l.Id).ToArray();
        var active = _layers.FirstOrDefault(l => l.Id == _activeLayerId) ?? _layers.LastOrDefault();

        var opacity = active?.Opacity ?? 1.0;
        var blend = active?.BlendMode ?? "source-over";

        await _canvasRef.Module.InvokeVoidAsync("syncLayers", ids, active?.Id, opacity, blend);
    }

    private async Task SyncActiveProps()
    {
        var i = ActiveLayerIndex;
        if (i < 0 || _canvasRef?.Module is null) return;
        var a = _layers[i];
        await _canvasRef.Module.InvokeVoidAsync("setActiveLayerProps", a.Opacity, a.BlendMode);
    }
}