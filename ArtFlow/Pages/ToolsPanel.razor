@* Components/ToolPanel.razor *@

<div class="tool-panel">
    <button class="tool-btn @(Selected == "pencil" ? "active" : "")"
            @onclick="@(() => Select("pencil"))" title="Кисть">
        ✏️
    </button>
    <button class="tool-btn @(Selected == "line" ? "active" : "")"
            @onclick="@(() => Select("line"))" title="Линия">
        📏
    </button>
    <button class="tool-btn @(Selected == "rect" ? "active" : "")"
            @onclick="@(() => Select("rect"))" title="Прямоугольник">
        ⬜
    </button>
    <button class="tool-btn @(Selected == "circle" ? "active" : "")"
            @onclick="@(() => Select("circle"))" title="Круг">
        ⭕
    </button>
</div>

<style>
    .tool-panel {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 10px 6px;
        background: #f5f5f5;
        border-right: 1px solid #ddd;
        height: 100%;
        box-sizing: border-box;
    }

    .tool-btn {
        width: 40px;
        height: 40px;
        font-size: 18px;
        cursor: pointer;
        border: 1px solid #ccc;
        background: #fff;
        border-radius: 6px;
        transition: all 0.15s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .tool-btn:hover {
            background: #e9ecef;
        }

        .tool-btn.active {
            background: #0078d7;
            color: white;
            border-color: #005a9e;
            box-shadow: 0 0 0 2px rgba(0,120,215,.25);
        }
</style>

@code {
    /// <summary>Текущий выбранный инструмент.</summary>
    [Parameter] public string Selected { get; set; } = "pencil";

    /// <summary>Уведомление родителя о смене инструмента.</summary>
    [Parameter] public EventCallback<string> SelectedChanged { get; set; }

    private async Task Select(string tool)
    {
        if (tool == Selected) return;
        await SelectedChanged.InvokeAsync(tool);
    }
}